{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xixi.event.v1/tool.approval.changed",
  "title": "tool.approval.changed payload v1",
  "description": "一条待批工具调用的状态变化（pack 03_AGENT_PLUGIN.md §5 的 model tool_call → permission ASK → 持久化 → 同意/拒绝/到期 → 执行冻结的调用）。只存程序判定要用的事实：approval_id、工具名、状态、reason_code、时间与冻结参数的**摘要**；不存冻结参数正文（它在 approvals 表里）、不存模型推理、不存对话原文（铁律 5）。score 是这次状态变化的可信度：1 = 人明确做的决定（同意/拒绝），0 = 程序判定的结束（到期），不是模型给的分数。",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "tool_name", "status", "reason_code", "requested_at", "expires_at"],
  "properties": {
    "approval_id": {
      "type": "string",
      "pattern": "^apr_[0-9a-f-]{36}$",
      "description": "待批请求的标识；与 approvals 表的主键一致，可回到那一行看冻结参数。"
    },
    "tool_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "expired", "executed"],
      "description": "与 pack 03 §5 的 PendingToolApproval.status 同一套取值。"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "程序的原因码（如 approval_requested / user_approved / user_denied / approval_expired / approval_execution_failed），不是模型写的句子。"
    },
    "session_id": { "type": ["string", "null"], "maxLength": 120 },
    "actor_id": { "type": ["string", "null"], "maxLength": 64 },
    "source_event_id": { "type": ["string", "null"], "maxLength": 120 },
    "frozen_args_digest": { "type": "string", "minLength": 8, "maxLength": 128 },
    "requested_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?[+-][0-9]{2}:[0-9]{2}$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?[+-][0-9]{2}:[0-9]{2}$"
    },
    "decided_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?[+-][0-9]{2}:[0-9]{2}$"
    },
    "decided_by": { "type": ["string", "null"], "maxLength": 64 },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  }
}
