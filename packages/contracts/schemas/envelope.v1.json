{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xixi.event.v1/envelope",
  "title": "Xixi Event Envelope v1",
  "description": "统一事件信封。payload 的形状由 event_type 对应的 payload schema 单独校验：envelope 校验通过后，validateEvent 会再用注册表中的 schema 校验 payload。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "event_id",
    "event_type",
    "timestamp",
    "source",
    "room",
    "actor",
    "confidence",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "schema": { "const": "xixi.event.v1" },
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "event_type": {
      "type": "string",
      "enum": ["presence.changed", "conversation.turn", "conversation.decision", "proactive.decision", "open_thread.changed", "system.health"]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?[+-][0-9]{2}:[0-9]{2}$"
    },
    "source": { "type": "string", "minLength": 1, "maxLength": 120 },
    "room": { "type": ["string", "null"], "maxLength": 120 },
    "actor": {
      "type": "string",
      "enum": ["father", "admin", "family_member", "unknown_person", "tv_media", "xixi", "system"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "correlation_id": { "type": "string", "pattern": "^corr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "payload": { "type": "object" }
  }
}
